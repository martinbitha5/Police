NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_HUB=FIH
# Tableau des vols public : lecture côté serveur avec le service_role (contourne
# la RLS qui réserve la lecture aux comptes authentifiés). On ne renvoie que des
# champs vol non sensibles. Ne jamais exposer cette clé côté client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Portails voisins listés dans la colonne « Produits » du pied de page.
# Facultatif : sans valeur, les sous-domaines de production sont utilisés
# (voir src/lib/site-apps.ts).
NEXT_PUBLIC_URL_TRACKING=
NEXT_PUBLIC_URL_LITIGE=
NEXT_PUBLIC_URL_WEB=
