NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Suivi bagage public : la lecture se fait côté serveur avec le service_role
# (contourne la RLS qui réserve la lecture aux comptes authentifiés). Ne jamais
# exposer cette clé côté client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Portails voisins listés dans la colonne « Autres services » du pied de page.
# Facultatif : sans valeur, les sous-domaines de production sont utilisés
# (voir src/lib/site-apps.ts).
NEXT_PUBLIC_URL_VOLS=
NEXT_PUBLIC_URL_LITIGE=
NEXT_PUBLIC_URL_WEB=
