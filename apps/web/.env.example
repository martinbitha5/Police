NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_HUB=FIH
# Applications sœurs listées dans la colonne « Produits » du pied de page.
# Facultatif : sans valeur, les sous-domaines de production sont utilisés
# (tracking / vols / litige .brsats.com — voir src/lib/site-apps.ts).
NEXT_PUBLIC_URL_TRACKING=
NEXT_PUBLIC_URL_VOLS=
NEXT_PUBLIC_URL_LITIGE=
# Server-only — gestion des comptes (admin.createUser). Ne jamais exposer côté client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
